# CastFabric Docker 部署配置
# 复制此文件为 .env。标准 DLNA 输出不需要小米账号。

# 局域网 IP（多网卡、Docker 或自动检测不准确时设置）
# CASTFABRIC_HOSTNAME=192.168.1.20

# 持久化配置目录（Docker Compose 变量）
# CASTFABRIC_CONFIG_DIR=./conf

# 以下均为可选的小米云扩展兼容字段
# 小米账号（手机号或邮箱）
MI_USER=

# 小米密码
MI_PASS=

# 旧设备 DID（迁移兼容；新安装通过 Web 选择 DLNA 输出目标）
# 多个设备用逗号分隔
MI_DID=
